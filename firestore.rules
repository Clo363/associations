rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leagues/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.size() >= 4 && code.size() <= 12
        && request.resource.data.keys().hasOnly(['name', 'base', 'level', 'packs', 'createdAt', 'creator'])
        && request.resource.data.get('level', 0) in [0, 1, 2, 3]
        && request.resource.data.get('packs', 0) is int
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.base in ['ru_adult', 'ru_kids', 'uk_adult', 'uk_kids', 'ru_all', 'uk_all'];

      match /players/{pid} {
        allow get, list: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(database)/documents/leagues/$(code))
          && pid.size() <= 40
          && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'results'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.results is map
          && request.resource.data.results.size() <= 1000;
      }
    }

    // Likes/dislikes: one document per device and clue, id starts with the device's user id.
    match /feedback/{fid} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && fid.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['base', 'answer', 'i', 'clue', 'vote', 't'])
        && request.resource.data.base in ['ru_adult', 'ru_kids', 'uk_adult', 'uk_kids']
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 20
        && request.resource.data.vote in [1, 0, -1];
    }
  }
}
