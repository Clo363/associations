rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leagues/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.size() >= 4 && code.size() <= 12
        && request.resource.data.keys().hasOnly(['name', 'base', 'createdAt', 'creator'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.base in ['ru_adult', 'ru_kids', 'uk_adult', 'uk_kids'];

      match /players/{pid} {
        allow get, list: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(database)/documents/leagues/$(code))
          && pid.size() <= 40
          && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'results'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.results is map
          && request.resource.data.results.size() <= 1000;
      }
    }
  }
}
